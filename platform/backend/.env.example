# Copy to .env and fill in your API keys

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_platform

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object storage (MinIO for dev)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ARTIFACTS=artifacts

# LLM providers (fill in at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-v4-flash

# Auth
SECRET_KEY=dev-secret-key-change-in-production

# Debug
DEBUG=false
LOCAL_DEMO_MODE=false
DATABASE_ECHO=false

# Formal harness bridge (disabled unless explicitly enabled).
HARNESS_BRIDGE_ENABLED=false
HARNESS_ROOT=
HARNESS_PYTHON=
HARNESS_STATE_ROOT=
HARNESS_TIMEOUT_SECONDS=900
