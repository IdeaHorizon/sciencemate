# 复制为 .env 并填写。绝不要提交 .env（已 gitignore）。
#
# 框架走 OpenAI-compatible API（POST /v1/chat/completions），任意 provider 都行 ——
# 只要它能接受 OpenAI 风格的请求即可。配置只有三个字段：
#
#   LLM_API_KEY     provider 的 API key（必填）
#   LLM_BASE_URL    provider 的 base URL（必填）
#   LLM_MODEL       模型名（必填）
#
# 下面从 (a) 到 (g) 是 7 个 provider 的样例。**选一组解开注释填上**，
# 或者直接照抄改 key 即可。每个同事用各自的 .env。

# ─────────────────────────────────────────────────────────────────────
# 必填三个字段 —— 从下面任选一组 provider 抄过来
# ─────────────────────────────────────────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ─────────────────────────────────────────────────────────────────────
# Provider 配置参考
# ─────────────────────────────────────────────────────────────────────

# (a) 团队 Maas（GLM-5.1）
# LLM_API_KEY=<你的 maas key>
# LLM_BASE_URL=http://maas.icompify.com:32788/v1
# LLM_MODEL=glm-5.1

# (b) DeepSeek（推荐 v4 系列：1M context、tool calls；旧 deepseek-chat 已 EOL）
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-pro        # 强模型，~$1.74/M tokens
# # LLM_MODEL=deepseek-v4-flash    # 便宜快，~$0.14/M tokens

# (c) OpenAI
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com
# LLM_MODEL=gpt-4o

# (d) OpenRouter（一个 key 调 200+ 模型）
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api
# LLM_MODEL=anthropic/claude-3.5-sonnet

# (e) 本地 ollama
# LLM_API_KEY=ollama          # 占位字符串即可，本地不验
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.1:70b

# (f) 本地 vLLM / LM Studio
# LLM_API_KEY=local
# LLM_BASE_URL=http://localhost:8000
# LLM_MODEL=qwen2.5-72b-instruct

# (g) Anthropic 通过 OpenAI-compatible proxy（如 litellm proxy）
# LLM_API_KEY=sk-anthropic-...
# LLM_BASE_URL=http://localhost:4000
# LLM_MODEL=claude-3-5-sonnet-20241022

# ─────────────────────────────────────────────────────────────────────
# 其它（可选）
# ─────────────────────────────────────────────────────────────────────

# runner 写 state（artifact、memory、transcript）的位置
STATE_DIR=./output

# 框架根（PROFILE.md / project KB 都在这下面）。默认 ~/.harness-framework/
# HARNESS_FRAMEWORK_HOME=~/.harness-framework

# 子节点递归深度上限（防 LLM 失控自递归；默认 4）
# HARNESS_FRAMEWORK_MAX_SUBAGENT_DEPTH=4

# 并行 subagent 数上限（默认 5）
# HARNESS_FRAMEWORK_MAX_PARALLEL=5

# LLM 上下文窗口大小（用于 summarizer 触发阈值的默认值，不是 API hard limit）。
# 配你 LLM 实际支持的窗口；超过 = summarizer 过早压历史浪费窗口，太小 = 长
# session 撞 API 报错。**留 20-30% 头部空间**给当轮输出 + hook 注入。
# 节点 yaml 里显式写 context_config.max_context_tokens 仍然优先（这只是默认）。
# 常见窗口：
#   GLM-5.1 / DeepSeek-V4 / GPT-4o      = 128000 → 推荐配 120000
#   Claude 3.x                          = 200000 → 推荐配 180000
#   o1 / o1-pro                         = 128000 → 推荐配 120000
#   llama3.1-8b / qwen2.5-7b（小模型）  = 32000-128000 看具体版本
# 默认 120000（cover 128K 主流）
# LLM_CONTEXT_WINDOW=120000

# LLM call transient 错重试次数（网络抖动 / 5xx / 429）。同事反映 LLM provider
# 偶发短时不稳定 —— 节点跑几小时被一次 blip 干死所有工作。加 retry 兜底。
# 节点 yaml 里 owner_config.llm.max_retries 仍可 override 这个默认。
# 设 0 = 完全关闭重试（旧行为，崩了直接挂）。
# LLM_MAX_RETRIES=3

# 重试退避基数秒（实际延迟 = base × 2^attempt + jitter，单次最长 30s）
# LLM_RETRY_BACKOFF_BASE=1.0

# 账户级 LLM 并发准入（#426）：同一台机器上所有 harness 进程（多路
# orchestrator、curator dreaming）共享的并发上限，按 endpoint 分组。
# 退避管"撞了 429 之后等多久"，这个管"别一起冲上去撞"——四路 E2E 同时
# 起跑时把 provider 并发位打满，退避救不回来（nidy4 实测整条管线被 429
# 打空）。**设成 provider 实际给你的并发配额**（GPUStack 的 per-user
# concurrency / 云厂商配额）。默认 8；0 = 关闭准入（恢复纯退避）。
# HARNESS_LLM_MAX_CONCURRENT=8

# Web 搜索后端（shared/tools/web.py 的 web_search / web_fetch）。无 API key。
# 默认 "auto"：先试 DuckDuckGo HTML（海外网络主力），失败/不通切百度（国内 fallback）。
# 想强制走单后端：设 "ddg" 或 "baidu"。
# 不用 Bing —— v1.x 实测 Bing 对自动化请求返 poisoned 结果（用 "LAMMPS tutorial"
# query 返回 "Google Docs Sign-in" / "Pancakes Recipe" 等无关内容，比失败更糟）。
# WEB_SEARCH_BACKEND=auto

# ─────────────────────────────────────────────────────────────────────
# v1.5: 多 LLM provider 注册 —— 让 agent 调 consult_other_model 拿第二意见
# ─────────────────────────────────────────────────────────────────────
# 列出你想让 agent 可以"咨询"的备用 LLM。主模型（LLM_API_KEY/LLM_BASE_URL/
# LLM_MODEL）会自动作为 primary 注册到列表头部，不需要在这里重复列。
#
# 每条 provider:
#   name         (str, 必填)：agent 调用时用的 ID（如 "claude" / "deepseek-v4-pro"）
#   model        (str, 必填)：传给该 provider 的模型名
#   base_url     (str, 必填)：OpenAI-compatible API endpoint
#   api_key_env  (str, 必填)：从这个 env var 取该 provider 的 API key
#                            （**不**把 key 直接放 JSON 里 —— 安全 + 易换）
#   description  (str, 可选)：给 agent 看的一句说明
#
# JSON 数组放单行字符串（shell 单引号）；schema 校验严，错的条目 warn 不阻塞
# 其它条目。详见 core/llm_providers.py。配套：把每个 provider 的 API key
# env var 都设上。
#
# 例：
# LLM_PROVIDERS_JSON='[{"name":"claude-opus","model":"claude-opus-4-7","base_url":"https://api.anthropic.com","api_key_env":"ANTHROPIC_API_KEY","description":"Anthropic 旗舰，跟 GLM/DeepSeek 不同家做 cross-check"},{"name":"deepseek-v4-pro","model":"deepseek-v4-pro","base_url":"https://api.deepseek.com","api_key_env":"DEEPSEEK_API_KEY","description":"DeepSeek V4 Pro，1M context"}]'
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...
